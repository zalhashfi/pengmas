# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# ---------------------------------------------------------------------------
# Skill pihak ketiga. Bukan kode project ini: berisi ~500 file dari paket
# eksternal. Sumber dan hash-nya sudah tercatat di `skills-lock.json`, sehingga
# repo ini tidak perlu menyalin isinya. Install ulang dengan:
#   npx skills add
# ---------------------------------------------------------------------------
/.agents/

# Cache TypeScript
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Gambar referensi desain. Disimpan lokal untuk acuan kerja, tidak di-push:
# file-nya milik pihak ketiga (Dribbble/Pinterest), bukan aset project ini.
# ---------------------------------------------------------------------------
/referensi/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
